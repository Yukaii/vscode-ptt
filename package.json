{
  "name": "vscode-ptt",
  "displayName": "VSCode 批踢踢 (VSCode PTT)",
  "description": "PTT Client for VSCode",
  "version": "0.4.1",
  "icon": "media/logo.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "preview": true,
  "categories": [
    "Other"
  ],
  "publisher": "Yukai",
  "author": {
    "email": "nyan@yukaii.tw",
    "name": "Yukai Huang",
    "url": "https://yukai.dev"
  },
  "license": "WTFPL",
  "activationEvents": [
    "onFileSystem:ptt",
    "onLanguage:ptt",
    "onCommand:ptt.login",
    "onCommand:ptt.logout",
    "onCommand:ptt.add-board",
    "onCommand:ptt.remove-board",
    "onCommand:ptt.search-board-by-push",
    "onCommand:ptt.refresh-article",
    "onCommand:ptt.favorite-board",
    "onCommand:ptt.toggle-live-tracking",
    "onCommand:ptt.start-live-tracking",
    "onCommand:ptt.stop-live-tracking",
    "onView:pttTree"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Yukaii/vscode-ptt"
  },
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "ptt",
        "aliases": [
          "PTT",
          "ptt"
        ],
        "extensions": [
          ".ptt"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ptt",
        "scopeName": "source.ptt",
        "path": "./syntaxes/ptt.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "ptt.login",
        "title": "登入",
        "category": "PTT",
        "icon": "$(sign-in)"
      },
      {
        "command": "ptt.logout",
        "title": "登出",
        "category": "PTT",
        "icon": "$(sign-out)"
      },
      {
        "command": "ptt.search-article-by-push",
        "title": "搜尋推文數",
        "category": "PTT"
      },
      {
        "command": "ptt.add-board",
        "title": "新增訂閱看板",
        "icon": "$(add)"
      },
      {
        "command": "ptt.remove-board",
        "title": "移除訂閱看板",
        "icon": "$(trash)"
      },
      {
        "command": "ptt.search-board-by-push",
        "title": "以推文數搜尋",
        "icon": "$(search)"
      },
      {
        "command": "ptt.refresh-article",
        "title": "重新整理看板列表",
        "icon": "$(refresh)"
      },
      {
        "command": "ptt.refresh-board",
        "title": "重新整理此看板文章",
        "icon": "$(refresh)"
      },
      {
        "command": "ptt.favorite-board",
        "title": "從我的最愛新增訂閱",
        "icon": "$(star)"
      },
      {
        "command": "ptt.toggle-live-tracking",
        "title": "切換即時追推文 (Toggle Live Tracking)",
        "category": "PTT",
        "icon": "$(radio-tower)"
      },
      {
        "command": "ptt.start-live-tracking",
        "title": "開啟即時追推文 (Start Live Tracking)",
        "category": "PTT",
        "icon": "$(radio-tower)"
      },
      {
        "command": "ptt.stop-live-tracking",
        "title": "停止即時追推文 (Stop Live Tracking)",
        "category": "PTT",
        "icon": "$(primitive-square)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ptt.login",
          "when": "view == pttTree && !ptt:loggedIn",
          "group": "navigation"
        },
        {
          "command": "ptt.add-board",
          "when": "view == pttTree && ptt:loggedIn",
          "group": "navigation@1"
        },
        {
          "command": "ptt.refresh-article",
          "when": "view == pttTree && ptt:loggedIn",
          "group": "navigation@2"
        },
        {
          "command": "ptt.logout",
          "when": "view == pttTree && ptt:loggedIn",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "ptt.refresh-board",
          "when": "view == pttTree && viewItem == board",
          "group": "inline@1"
        },
        {
          "command": "ptt.refresh-board",
          "when": "view == pttTree && viewItem == board",
          "group": "1_modification@1"
        },
        {
          "command": "ptt.search-board-by-push",
          "when": "view == pttTree && viewItem == board",
          "group": "1_modification@2"
        },
        {
          "command": "ptt.remove-board",
          "when": "view == pttTree && viewItem == board",
          "group": "1_modification@3"
        }
      ],
      "editor/title": [
        {
          "command": "ptt.start-live-tracking",
          "when": "resourceScheme == ptt && !ptt:isLiveTracking",
          "group": "navigation"
        },
        {
          "command": "ptt.stop-live-tracking",
          "when": "resourceScheme == ptt && ptt:isLiveTracking",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "ptt.toggle-live-tracking",
          "when": "resourceScheme == ptt",
          "group": "ptt@1"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "pttTree",
        "contents": "尚未登入 PTT。\n[登入](command:ptt.login)"
      }
    ],
    "views": {
      "ptt-explorer": [
        {
          "id": "pttTree",
          "name": "文章列表"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ptt-explorer",
          "title": "VSCode PTT",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "configuration": [
      {
        "title": "VSCode PTT 設定",
        "properties": {
          "kickLogin": {
            "description": "強行登入（踢出已登入使用者）",
            "type": "boolean",
            "scope": "window",
            "default": false
          },
          "previewImages": {
            "description": "在懸浮提示中預覽 Imgur 及圖片連結 (Preview Imgur and image links in hover card)",
            "type": "boolean",
            "scope": "window",
            "default": true
          },
          "previewImageWidth": {
            "description": "懸浮提示中的圖片預覽寬度（像素，設為 0 則不限制）(Image preview width in hover card in pixels, set to 0 for unconstrained)",
            "type": "number",
            "scope": "window",
            "default": 320
          },
          "liveTrackingInterval": {
            "description": "即時追推文更新頻率（秒）(Live tracking refresh interval in seconds)",
            "type": "number",
            "scope": "window",
            "default": 3,
            "minimum": 1,
            "maximum": 60
          },
          "liveTrackingAutoScroll": {
            "description": "即時追推文時自動捲動至文章底部 (Auto scroll to bottom during live tracking)",
            "type": "boolean",
            "scope": "window",
            "default": true
          }
        }
      }
    ]
  },
  "packageManager": "pnpm@12.0.0+sha512.9e2e3dc3911995868dc94b8175c217c27e95408fa03b4a22749778f2b34f773b77cdd3b39ede8171b22fcd53be6a35342e9fac9948a68ef58df6488ce89a7e67",
  "scripts": {
    "vscode:prepublish": "pnpm build",
    "build": "pnpm --filter ptt-client build && esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --minify --sourcemap",
    "compile": "pnpm --filter ptt-client build && tsc -p ./",
    "cleanAndCompile": "tsc --build --clean && pnpm --filter ptt-client build && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "test:unit": "mocha --require ./out/test/unit/setup.js ./out/test/unit/**/*.test.js",
    "test:integration": "vscode-test",
    "test": "pnpm compile && pnpm test:unit && pnpm --filter ptt-client test",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/vscode": "~1.85.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "dotenv": "^16.6.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "glob": "^10.5.0",
    "mocha": "^10.8.2",
    "ovsx": "^1.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "ws": "^8.21.3"
  },
  "dependencies": {
    "@hackmd/react-vsc-treeview": "^0.2.5",
    "ptt-client": "workspace:*",
    "react": "^18.3.1"
  }
}
